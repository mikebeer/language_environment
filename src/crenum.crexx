/* crenum - CRE number services, v0 draft. See spec/num.md */
options levelb
namespace crenum expose isint isdecimal parseint fixed parsefloat realtext
import rxfnsb
import crecond

/* 1 if s is [+-] followed by one or more ASCII digits, nothing else */
isint: procedure = .int
  arg s = .string
  r = s
  if length(r) >= 1 then do
    ch = left(r,1)
    if ch = "+" | ch = "-" then r = substr(r,2)
  end
  if r = "" then return 0
  if verify(r, "0123456789") = 0 then return 1
  return 0

/* 1 if s is a plain decimal: [+-] digits [. digits] [e [+-] digits], or [+-] . digits ...
   Written with a few built-in string calls on purpose: a character loop costs about 4 us per call
   on the VM and a signal block about 11 us. Checked against a character-by-character reference on
   all 813,616 strings of length 0 to 5 over the alphabet 0-9 + - . e E: no differences. */
isdecimal: procedure = .int
  arg s = .string
  t = s
  if t = "" then return 0
  ch = left(t, 1)
  if ch = "+" | ch = "-" then t = substr(t, 2)
  e = verify(t, "0123456789.")
  if e = 0 then m = t
  else do
    ch = substr(t, e, 1)
    if ch \= "e" & ch \= "E" then return 0
    m = left(t, e - 1)
    x = substr(t, e + 1)
    if x = "" then return 0
    ch = left(x, 1)
    if ch = "+" | ch = "-" then x = substr(x, 2)
    if x = "" then return 0
    if verify(x, "0123456789") <> 0 then return 0
  end
  d = pos(".", m)
  if d = 0 then do
    if m = "" then return 0
    return 1
  end
  if length(m) = 1 then return 0
  if pos(".", m, d + 1) > 0 then return 0
  return 1

/* parse an integer. Bad syntax: CONVERSION_ERROR. Syntax fine but not representable: OUT_OF_RANGE */
parseint: procedure = .int
  arg s = .string
  if isint(s) = 0 then call crecond..raise("conversion_error", "not an integer")
  do
    v = s as .int
    return v
  on signal as c
    call crecond..raise("out_of_range", "integer does not fit")
  end
  return 0

/* x rounded half away from zero to `places` decimals, fixed notation, no negative zero */
fixed: procedure = .string
  arg x = .string, places = .int
  if places < 0 then call crecond..raise("invalid_arguments", "places must not be negative")
  if isdecimal(x) = 0 then call crecond..raise("conversion_error", "not a decimal number")
  d = x as .decimal
  r = format(d,,places)
  if pos("E", upper(r)) > 0 then call crecond..raise("out_of_range", "needs exponent form")
  if left(r,1) = "-" then do
    if verify(substr(r,2), "0.") = 0 then r = substr(r,2)
  end
  return r

/* parse a plain decimal number (isdecimal syntax) to .float. Otherwise CONVERSION_ERROR.
   One verify call rejects every character outside the number alphabet (this is what keeps
   inf, nan, hex and blanks out); the runtime's own decimal conversion then checks the structure and
   raises CONVERSION_ERROR itself. Over the alphabet it accepts exactly what isdecimal accepts
   (same 813,616-string check). The message of a structural failure is the runtime's, not ours. */
parsefloat: procedure = .float
  arg s = .string
  if s = "" then call crecond..raise("conversion_error", "not a decimal number")
  if verify(s, "0123456789+-.eE") <> 0 then call crecond..raise("conversion_error", "not a decimal number")
  d = s as .decimal
  f = d as .float
  return f

/* text of a float: shortest form the runtime gives, exponent letter E, "nan" for NaN */
realtext: procedure = .string
  arg x = .float
  if x \= x then return "nan"
  s = x as .string
  return translate(s, "E", "e")
