/* cretext - CRE text services, v0 draft. See spec/text.md
   Shape note: each procedure assigns length(c) to a local before using it, has no
   helper call and no 'return length(...)' expression. The rxc inliner exports a
   body for cross-module inlining only in that shape (measured on 1.0.0-beta.3), so
   calls from other programs compile to inline code instead of a procedure call. */
options levelb
namespace cretext expose isdigit isalpha isalnum isspace isupper islower
import rxfnsb

isdigit: procedure = .int
  arg c = .string
  n = length(c)
  if n = 1 then do
    k = c2d(c)
    if k >= 48 & k <= 57 then return 1
  end
  return 0

isupper: procedure = .int
  arg c = .string
  n = length(c)
  if n = 1 then do
    k = c2d(c)
    if k >= 65 & k <= 90 then return 1
  end
  return 0

islower: procedure = .int
  arg c = .string
  n = length(c)
  if n = 1 then do
    k = c2d(c)
    if k >= 97 & k <= 122 then return 1
  end
  return 0

isalpha: procedure = .int
  arg c = .string
  n = length(c)
  if n = 1 then do
    k = c2d(c)
    if k >= 65 & k <= 90 then return 1
    if k >= 97 & k <= 122 then return 1
  end
  return 0

isalnum: procedure = .int
  arg c = .string
  n = length(c)
  if n = 1 then do
    k = c2d(c)
    if k >= 48 & k <= 57 then return 1
    if k >= 65 & k <= 90 then return 1
    if k >= 97 & k <= 122 then return 1
  end
  return 0

/* space, tab, LF, VT, FF, CR */
isspace: procedure = .int
  arg c = .string
  n = length(c)
  if n = 1 then do
    k = c2d(c)
    if k = 32 | (k >= 9 & k <= 13) then return 1
  end
  return 0
