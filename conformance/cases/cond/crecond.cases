# crecond / failure-convention cases. Helpers live in crecond.prelude
trapint|'42'|'ok 42'
trapint|'12x'|'CONVERSION_ERROR: not an integer'
trapint|''|'CONVERSION_ERROR: not an integer'
trapint|' 7'|'CONVERSION_ERROR: not an integer'
trapint|'99999999999999999999'|'OUT_OF_RANGE: integer does not fit'
trapfixed|'1',-1|'INVALID_ARGUMENTS: places must not be negative'
trapfixed|'1e22',0|'OUT_OF_RANGE: needs exponent form'
trapfixed|'1.25',1|'ok 1.3'
trapraise|'failure','disk full'|'FAILURE: disk full'
trapraise|'error',''|'ERROR'
