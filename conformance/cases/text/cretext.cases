# cretext conformance cases. Format: function | arguments | expected
# Arguments use U+{hhhh} for non-ASCII characters; "|" separates fields.
# Strings are the text between ' ' quotes. All results are integers.
isdigit|'0'|1
isdigit|'9'|1
isdigit|'a'|0
isdigit|''|0
isdigit|'12'|0
isdigit|'U+{0663}'|0
isalpha|'a'|1
isalpha|'Z'|1
isalpha|'5'|0
isalpha|'_'|0
isalpha|'U+{00E9}'|0
isalnum|'q'|1
isalnum|'7'|1
isalnum|'-'|0
isspace|' '|1
isspace|'U+{0009}'|1
isspace|'U+{000A}'|1
isspace|'U+{000D}'|1
isspace|'x'|0
isspace|'U+{00A0}'|0
isupper|'A'|1
isupper|'a'|0
islower|'a'|1
islower|'A'|0
